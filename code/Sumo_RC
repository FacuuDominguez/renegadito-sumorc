#include <Bluepad32.h>

// === Pines de los motores ===
#define IN1A 4  // Motor izquierdo
#define IN1B 16
#define IN2A 22 // Motor derecho
#define IN2B 23

ControllerPtr myController;

// === Función para mover motores ===
void setMotor(int inA, int inB, int speed) {
  speed = constrain(speed, -255, 255);

  if (speed > 0) {
    analogWrite(inA, speed);
    analogWrite(inB, 0);
  } else if (speed < 0) {
    analogWrite(inA, 0);
    analogWrite(inB, -speed);
  } else {
    analogWrite(inA, 0);
    analogWrite(inB, 0);
  }
}

// === Evento cuando se conecta un mando ===
void onConnectedController(ControllerPtr ctl) {
  myController = ctl;
  Serial.println("Control PS4 conectado!");
}

void onDisconnectedController(ControllerPtr ctl) {
  myController = nullptr;
  Serial.println("Control PS4 desconectado!");
}

void setup() {
  Serial.begin(115200);

  // Pines de salida
  pinMode(IN1A, OUTPUT);
  pinMode(IN1B, OUTPUT);
  pinMode(IN2A, OUTPUT);
  pinMode(IN2B, OUTPUT);

  // Iniciar Bluepad32
  BP32.setup(&onConnectedController, &onDisconnectedController);
  BP32.forgetBluetoothKeys();
}
void loop() {
  BP32.update();

  if (myController && myController->isConnected()) {
    // LY = Stick Izquierdo (Arriba/Abajo) -> Controla Motor Izquierdo
    int ly = myController->axisY();    
    // RY = Stick Derecho (Arriba/Abajo) -> Controla Motor Derecho
    int ry = myController->axisRY();   

    // Normalizar a -255 .. 255 e invertir porque arriba suele ser negativo
    int motorLeft = map(ly, -511, 512, 250, -250);
    int motorRight = map(ry, -511, 512, 250, -250);

    // Aplicar una pequeña zona muerta para que no se muevan solos si el stick no está perfecto
    if (abs(motorLeft) < 15) motorLeft = 0;
    if (abs(motorRight) < 15) motorRight = 0;

    // Mover cada motor con su respectivo joystick
    setMotor(IN1A, IN1B, motorLeft);
    setMotor(IN2A, IN2B, motorRight);

    // Debug
    Serial.print("M_Izq: "); Serial.print(motorLeft);
    Serial.print(" | M_Der: "); Serial.println(motorRight);
  }
}
